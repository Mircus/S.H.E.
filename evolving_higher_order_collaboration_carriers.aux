\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Window summary for the first real SDM slice extracted from DBLP. Even this narrow venue-level subset already produces nontrivial higher-order structure across all rolling windows.}}{8}{table.1}\protected@file@percent }
