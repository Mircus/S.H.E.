\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Mean predictive scores across the evaluated SDM windows after introducing the hybrid evolving score. Persistence remains the strongest positive signal by correlation, but the geometry--field score is now also strongly positive and attains mean top-$k$ precision $1.0$ on this slice.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:sdm-model-comparison}{{2}{8}{Mean predictive scores across the evaluated SDM windows after introducing the hybrid evolving score. Persistence remains the strongest positive signal by correlation, but the geometry--field score is now also strongly positive and attains mean top-$k$ precision $1.0$ on this slice}{table.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8}First results on an SDM slice}{8}{section.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Mean top-$k$ predictive precision on the SDM slice after hybridizing the evolving score. The geometry--field score now matches the strongest ranking precision on this venue slice.}}{9}{figure.1}\protected@file@percent }
\newlabel{fig:sdm-predictive-comparison}{{1}{9}{Mean top-$k$ predictive precision on the SDM slice after hybridizing the evolving score. The geometry--field score now matches the strongest ranking precision on this venue slice}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Representative collaboration carriers surfaced by the revised evolving-geometry ranking on the SDM slice. At the current stage these highlighted examples are recurrent pair-level carriers with nonzero future support, not yet a claim that larger simplices dominate pair-level signals on real data.}}{9}{table.3}\protected@file@percent }
\newlabel{tab:sdm-carriers}{{3}{9}{Representative collaboration carriers surfaced by the revised evolving-geometry ranking on the SDM slice. At the current stage these highlighted examples are recurrent pair-level carriers with nonzero future support, not yet a claim that larger simplices dominate pair-level signals on real data}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Window-by-window predictive performance on the SDM slice for simplex support, frozen diffusion, and evolving geometry. The revised evolving score is now positive across the evaluated windows and much closer to persistence than in the earlier draft, although persistence remains the strongest simple correlation signal overall.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:sdm-temporal-performance}{{2}{10}{Window-by-window predictive performance on the SDM slice for simplex support, frozen diffusion, and evolving geometry. The revised evolving score is now positive across the evaluated windows and much closer to persistence than in the earlier draft, although persistence remains the strongest simple correlation signal overall}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Cross-venue comparison of the strongest simple baseline and the revised evolving geometry score on the broad future-support task. The evolving score is now strongly positive on both venue slices and matches persistence in mean top-$k$ precision, but persistence still retains the stronger average correlation with future support.}}{10}{table.4}\protected@file@percent }
\newlabel{tab:cross-venue}{{4}{10}{Cross-venue comparison of the strongest simple baseline and the revised evolving geometry score on the broad future-support task. The evolving score is now strongly positive on both venue slices and matches persistence in mean top-$k$ precision, but persistence still retains the stronger average correlation with future support}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cross-venue summary for SDM and WSDM on the broad future-support task. The revised evolving score is now strongly positive and matches persistence in mean top-$k$ precision across both venue slices, but persistence retains the stronger mean correlation with future support.}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:cross-venue}{{3}{11}{Cross-venue summary for SDM and WSDM on the broad future-support task. The revised evolving score is now strongly positive and matches persistence in mean top-$k$ precision across both venue slices, but persistence retains the stronger mean correlation with future support}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Bridge-emergence regime across the two venue slices. Here the target is future branching into novel triangle contexts among low-persistence bridge candidates. Persistence no longer dominates: the evolving score exceeds persistence in mean Spearman correlation on both venues, although the strongest regime-specific baseline is not the same on the two slices.}}{11}{table.5}\protected@file@percent }
\newlabel{tab:bridge-regime}{{5}{11}{Bridge-emergence regime across the two venue slices. Here the target is future branching into novel triangle contexts among low-persistence bridge candidates. Persistence no longer dominates: the evolving score exceeds persistence in mean Spearman correlation on both venues, although the strongest regime-specific baseline is not the same on the two slices}{table.5}{}}
